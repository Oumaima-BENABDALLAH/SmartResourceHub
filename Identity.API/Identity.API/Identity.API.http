@identityUrl = http://localhost:7001

### 1. Register
POST {{identityUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Oumaima",
  "lastName": "Ben",
  "email": "oumaima@test.com",
  "password": "Test1234!"
}

### 2. Login → copiez accessToken + refreshToken + id
POST {{identityUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "oumaima@test.com",
  "password": "Test1234!"
}

### 3. Me 
GET {{identityUrl}}/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..S7Lv1UJk0OgHm4VA8m5gN3qVYb24Zpvv1KMXQ2GvYdE

### 4. Logout
POST {{identityUrl}}/api/auth/logout
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..S7Lv1UJk0OgHm4VA8m5gN3qVYb24Zpvv1KMXQ2GvYdE

### 5. Refresh
POST {{identityUrl}}/api/auth/refresh
Content-Type: application/json

{
  "userId": "afe985b4-7844-485b-bd36-ddb84573bea7",
  "refreshToken": "EWdbS83Dt/eKWGAKLU4TYjDog0g8OQ6sZMY1W9Bmup+hbMJBGRHTJVeuZpQiVHBEv+Qh+05l+TfNDl96O+LwHQ=="
}
